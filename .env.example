# Production site origin used for canonical URLs, Open Graph, sitemap, robots and prerender.
# Example: https://www.your-domain.com
# Do not include a trailing slash.
#
# Required for production / Vercel builds.
# Set this in Vercel → Project → Settings → Environment Variables (Production):
#   VITE_SITE_URL=https://YOUR-PRODUCTION-DOMAIN.com
#
# Without it, SEO uses https://YOUR-PRODUCTION-DOMAIN (never localhost).
VITE_SITE_URL=
