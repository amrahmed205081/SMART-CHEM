{
  "name": "smartchem",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "seo:generate": "node scripts/generate-seo.mjs",
    "spa-shell": "node scripts/ensure-spa-shell.mjs",
    "images:optimize": "node scripts/optimize-site-images.mjs",
    "prerender": "node scripts/prerender.mjs",
    "prerender:verify": "node scripts/verify-prerender.mjs",
    "build": "npm run seo:generate && tsc --noEmit && vite build && npm run prerender",
    "build:vercel": "npm run seo:generate && tsc --noEmit && vite build && npm run spa-shell",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
